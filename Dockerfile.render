# Multi-stage build for optimal image size
FROM node:18-alpine as builder

WORKDIR /app

# No dependencies needed, just copying HTML
COPY afreen_advanced_birthday.html .

# Production stage
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Copy website
COPY --from=builder /app/afreen_advanced_birthday.html /usr/share/nginx/html/index.html

# Create default nginx directories if they don't exist
RUN mkdir -p /usr/share/nginx/html && \
    mkdir -p /var/cache/nginx && \
    mkdir -p /var/run/nginx

# Expose port (must be 80 for Render)
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
